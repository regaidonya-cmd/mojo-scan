# ══════════════════════════════════════════════════
# MOJO SCAN FLASH — Variables d'environnement
# Copier en .env.local et remplir les valeurs
# Ne JAMAIS committer .env.local sur Git
# ══════════════════════════════════════════════════

# Supabase (depuis Settings > API dans votre projet Supabase)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# URL publique du scan (pour les liens de rapport)
NEXT_PUBLIC_URL=https://scan.mojoacademie.com

# HubSpot (Private App Token)
# Dashboard HubSpot > Settings > Integrations > Private Apps
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Resend (pour les emails transactionnels)
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin password (pour /admin)
ADMIN_PASSWORD=changez-moi-en-production-xxxx
